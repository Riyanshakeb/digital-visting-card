<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/black">

    <com.snakegame.ag.engine.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">

        <TextView android:id="@+id/tvScore" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Score: 0" android:textColor="@color/white"
            android:textSize="18sp" android:textStyle="bold" android:background="@drawable/bg_score" />

        <TextView android:id="@+id/tvBest" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Best: 0" android:textColor="#A5D6A7" android:textSize="14sp"
            android:layout_marginStart="12dp" android:background="@drawable/bg_score" />

        <ImageButton android:id="@+id/btnPause" android:layout_width="44dp" android:layout_height="44dp"
            android:layout_marginStart="12dp" android:background="@drawable/bg_score"
            android:src="@android:drawable/ic_media_pause" android:scaleType="centerInside"
            android:contentDescription="@string/pause" />
    </LinearLayout>

    <!-- Pause overlay -->
    <LinearLayout android:id="@+id/pauseOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#CC000000" android:gravity="center" android:orientation="vertical"
        android:visibility="gone" android:clickable="true" android:focusable="true">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="PAUSED" android:textColor="@color/white" android:textSize="32sp"
            android:textStyle="bold" android:layout_marginBottom="24dp" />

        <Button android:id="@+id/btnResume" android:layout_width="180dp" android:layout_height="50dp"
            android:background="@drawable/bg_btn_play" android:text="@string/resume"
            android:textColor="@color/white" android:textAllCaps="false" android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button android:id="@+id/btnMenuFromPause" android:layout_width="180dp" android:layout_height="46dp"
            android:background="@drawable/bg_btn_secondary" android:text="@string/menu"
            android:textColor="@color/white" android:textAllCaps="false" android:textSize="14sp" />
    </LinearLayout>

    <!-- Game Over overlay -->
    <LinearLayout android:id="@+id/gameOverOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#E0000000" android:gravity="center" android:orientation="vertical"
        android:visibility="gone" android:clickable="true" android:focusable="true">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/game_over" android:textColor="#EF5350" android:textSize="36sp"
            android:textStyle="bold" android:layout_marginBottom="16dp" />

        <TextView android:id="@+id/tvFinalScore" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0" android:textColor="@color/white" android:textSize="64sp"
            android:textStyle="bold" android:layout_marginBottom="4dp" />

        <TextView android:id="@+id/tvNewBest" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/new_best" android:textColor="#FFD740" android:textSize="18sp"
            android:visibility="gone" android:layout_marginBottom="8dp" />

        <TextView android:id="@+id/tvGameOverBest" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Best: 0" android:textColor="#A5D6A7" android:textSize="16sp"
            android:layout_marginBottom="32dp" />

        <Button android:id="@+id/btnRetry" android:layout_width="200dp" android:layout_height="54dp"
            android:background="@drawable/bg_btn_play" android:text="@string/retry"
            android:textColor="@color/white" android:textAllCaps="false" android:textSize="17sp"
            android:textStyle="bold" android:layout_marginBottom="12dp" />

        <Button android:id="@+id/btnMenuFromOver" android:layout_width="200dp" android:layout_height="46dp"
            android:background="@drawable/bg_btn_secondary" android:text="@string/menu"
            android:textColor="@color/white" android:textAllCaps="false" android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
