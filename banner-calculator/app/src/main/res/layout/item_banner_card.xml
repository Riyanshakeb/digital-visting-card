<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="10dp"
    android:elevation="2dp">

    <!-- Header: Title + Price + Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Item 1"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PKR 0.00"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnDeleteItem"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/delete"
            android:scaleType="centerInside" />
    </LinearLayout>

    <!-- Material Spinner -->
    <Spinner
        android:id="@+id/spinnerMaterial"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_unit_selector"
        android:layout_marginTop="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- Width Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="W"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/etWidth"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="0"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="15sp"
            android:layout_marginEnd="8dp"
            android:importantForAutofill="no"
            android:singleLine="true" />

        <Spinner
            android:id="@+id/spinnerWidthUnit"
            android:layout_width="85dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_unit_selector"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </LinearLayout>

    <!-- Height Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="H"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/etHeight"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="0"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="15sp"
            android:layout_marginEnd="8dp"
            android:importantForAutofill="no"
            android:singleLine="true" />

        <Spinner
            android:id="@+id/spinnerHeightUnit"
            android:layout_width="85dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_unit_selector"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />
    </LinearLayout>

    <!-- Qty + Rate Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="Qty"
            android:textSize="12sp"
            android:textColor="@color/text_secondary_light" />

        <EditText
            android:id="@+id/etQty"
            android:layout_width="60dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:hint="1"
            android:inputType="number"
            android:gravity="center"
            android:text="1"
            android:textSize="15sp"
            android:layout_marginEnd="12dp"
            android:importantForAutofill="no"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rate"
            android:textSize="12sp"
            android:textColor="@color/text_secondary_light"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etRate"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="0"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="15sp"
            android:importantForAutofill="no"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Area Display -->
    <TextView
        android:id="@+id/tvItemArea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Area: 0.00 sq.ft"
        android:textSize="12sp"
        android:textColor="@color/text_secondary_light"
        android:layout_marginTop="8dp" />
</LinearLayout>
